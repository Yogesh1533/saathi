# ── The brain ────────────────────────────────────────────────────────
# nebius    = NVIDIA Nemotron on Nebius Token Factory (default). Check which
#             models your key can use: python -m saathi nebius-models --probe
# agent-sdk = a Claude Pro/Max login through the Claude Code CLI
# api       = an Anthropic API key (ANTHROPIC_API_KEY)
LLM_BACKEND=nebius
NEBIUS_API_KEY=
# Models: main, quick commands, planning, screenshots. Defaults shown.
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# NEBIUS_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL     # empty = screen reading off
# NEBIUS_SYSTEM_PREFIX=/no_think       # keeps Nemotron reasoning off for snappy voice
# NEBIUS_PRIVACY=on                    # mask emails / phone / card numbers before they leave the Mac
LLM_MAX_TOKENS=4096

# Tavily web search (free tier at app.tavily.com). Empty = DuckDuckGo.
TAVILY_API_KEY=

# Only for the Claude backends:
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=low

# ── Speech to text ───────────────────────────────────────────────────
# auto   = Whisper large-v3-turbo on the GPU on Apple Silicon (MLX), else local (default)
# mlx    = always the GPU model (MLX_WHISPER_MODEL to change it)
# local  = faster-whisper on the CPU (WHISPER_MODEL)
# openai = OpenAI Whisper API (needs OPENAI_API_KEY)
STT_PROVIDER=auto
WHISPER_MODEL=base.en
# Names and words Saathi should expect (contacts, artists, places), comma-separated
STT_VOCABULARY=
OPENAI_API_KEY=

# ── Text to speech ───────────────────────────────────────────────────
# piper (local, free, default) | elevenlabs | openai
TTS_PROVIDER=piper
# Path to a downloaded Piper voice model (.onnx). See README for download steps.
PIPER_VOICE=./data/voices/en_GB-alan-medium.onnx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_TTS_VOICE=alloy

# ── Wake word ────────────────────────────────────────────────────────
# Wake word: path to a custom openWakeWord model (default models/hey_saathi.onnx,
# see docs/wake-word.md), or a built-in name such as hey_mycroft.
# WAKE_WORD_MODEL=models/hey_saathi.onnx
# No model? Wake on the name by transcribing idle speech locally (off = Space only).
# WAKE_BY_NAME=on
# How the voice says its own name (साथी = "saa-tee"). Try Saahtee, Sahtee, Saa-tee.
# SAATHI_SAY=Saahtee
# 0..1 — raise if it false-triggers, lower if it misses you
WAKE_THRESHOLD=0.5

# ── Timings (seconds) ────────────────────────────────────────────────
# How long Saathi keeps listening for a follow-up after replying
FOLLOWUP_WINDOW=6
# How long to wait for you to start speaking after the wake word
RECORD_START_TIMEOUT=6
# Pauses are handled by the "patience" setting (snappy / balanced /
# patient), changed in the HUD or by voice; see saathi/audio/turns.py
# Hard cap on a single utterance
MAX_UTTERANCE_SECONDS=60
# How often the reminder scheduler checks for due reminders
REMINDER_POLL_SECONDS=5
# Mic RMS level (int16) above which audio counts as speech, used only if
# the neural speech detector can't load
RMS_THRESHOLD=500

# ── Google (Gmail + Calendar) ────────────────────────────────────────
# OAuth client file downloaded from Google Cloud Console (Desktop app)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./data/google_token.json

# ── Weather & files ──────────────────────────────────────────────
# City for weather; leave empty to locate this machine by IP
WEATHER_LOCATION=
# Folders Saathi may search, read and open (comma-separated)
FILES_ROOTS=~/Documents,~/Desktop,~/Downloads,~/Library/Mobile Documents/com~apple~CloudDocs

# ── Semantic recall ──────────────────────────────────────────────
# Local embedding model (downloaded once, ~100 MB). Keep the cache outside
# iCloud: it evicts files.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_CACHE_DIR=~/.cache/saathi/models
# Cosine score below which a recalled item counts as not relevant
RECALL_MIN_SCORE=0.50
# 0 = don't index conversation turns (memories are still indexed)
RECALL_INDEX_TURNS=1
# Memories are all put in the prompt up to this many characters; beyond it
# only a one-line index is, and Saathi uses the recall tool for the rest
MEMORY_PRELOAD_CHARS=6000

# ── Paths ────────────────────────────────────────────────────────────
SYSTEM_PROMPT_PATH=./config/saathi-voice-assistant-system-prompt.md
MEMORY_DIR=./memory
DB_PATH=./data/saathi.db
